//@version=5
indicator("QuantC Backup ORB-A (hold to close) - PAPER TEST ONLY", overlay=true, max_labels_count=500, max_lines_count=50)

// ============================================================================
// PAPER TEST ONLY - DRAFT written 12 Oct 2026. NOT loaded in TradingView, NO
// alert created, NOT connected to Ghost. Every alert carries "test":true and
// that is HARD-CODED (TEST_MODE is a constant, not an input), so this script
// cannot place a real order even if a setting is clicked by mistake. Going
// live would need a deliberate source edit plus the user's explicit yes.
//
// PURPOSE: forward paper test of the backup plan in
// research/BACKUP_TEST_PLAN_2026_10_12.md. It checks whether the plain
// Nasdaq opening-range breakout (long side) keeps its measured edge on new
// days. It is NOT a live strategy, and 20-40 trades cannot prove an edge.
//
// VARIANT A (this file): enter on the breakout, HOLD TO THE 16:00 CLOSE, no
// stop. This is the exact mechanism measured in orb_breakout/orb_test.py.
// VARIANT B (sister file, same code, USE_STOP = true): the same entry with a
// stop at the opposite side of the opening range (STOPLOSS_HYPOTHESIS.md).
// The two files are generated from one source and differ ONLY in the title
// and the USE_STOP line, so any difference in results is the exit rule.
//
// RULES (frozen; copied from HYPOTHESIS.md section 3 and stoploss_test.py):
//   1. Opening range = high and low of the 1-minute bars 09:30-09:44 New York
//      time (15 bars). Fewer than 15 bars that day -> no trade that day.
//   2. From 09:45, the FIRST 1-minute bar that CLOSES above the range high is
//      the entry (entry price = that bar's close). Once per day.
//   3. LONG ONLY, and only if no bar closed BELOW the range low earlier that
//      day. This matters: the original test took a long only when the long
//      breakout came first. (The live MES script did not, which is one
//      reason its trade count and results differ from this test.)
//   4. Exit A: the 15:59 bar's close (the last bar before 16:00).
//      Exit B: as A, but if any later bar's LOW reaches the range low, exit
//      at the range low (assumed filled exactly there, as in the research).
//
// DIFFERENCES vs the research, stated up front:
//   - No costs are charged. Real round-trip cost is about 0.5 pt per MNQ;
//     subtract it when scoring.
//   - Variant B's stop fill is exact at the range low in this script, as in
//     the research. Real fills through a fast move would be worse.
//   - An entry on the very last bar (15:59) is skipped here (it would exit on
//     the same bar). Immaterial.
//   - US holiday and early-close days are SKIPPED outright (skipDay list
//     below), because a bar-based exit cannot fire when no bar prints after
//     13:00. The Python replay found 22 such days in 5 years (about 3% of
//     trades); the research counted them, this script does not. The list
//     must be checked against the CME holiday calendar and extended past
//     Feb 2027.
//   - Needs the MNQ 1-minute chart; any other symbol or timeframe is blocked.
//
// NOT YET DONE (needs the user's yes): compile-check in TradingView, load on
// a chart, create the alert, and record the start date. This file has NOT
// been compiled - treat any compile error as expected until checked.
// ============================================================================

TEST_MODE = true          // hard-coded paper mode - do not turn into an input
USE_STOP  = false         // false = Variant A (hold to close). true = Variant B.
QTY       = 1             // 1 micro contract
VARIANT   = USE_STOP ? "B" : "A"

canTrade = syminfo.root == "MNQ" and timeframe.period == "1"

etYear  = year(time, "America/New_York")
etMonth = month(time, "America/New_York")
etDay   = dayofmonth(time, "America/New_York")
// US holidays / early-close days when CME equity futures stop at 12:59 or 13:14 ET - skipped.
// Dates below are inferred from the pattern in 5 years of data (Python replay, 12 Oct 2026) and
// MUST be checked against the CME holiday calendar before use. Dates after 2027-02 are not listed.
skipDay = (etYear == 2026 and etMonth == 11 and (etDay == 26 or etDay == 27)) or (etYear == 2026 and etMonth == 12 and etDay == 24) or (etYear == 2027 and etMonth == 1 and etDay == 18) or (etYear == 2027 and etMonth == 2 and etDay == 15)

rangeWin      = not na(time(timeframe.period, "0930-0945", "America/New_York"))
inSession     = not na(time(timeframe.period, "0945-1600", "America/New_York"))
lastBar       = not na(time(timeframe.period, "1559-1600", "America/New_York"))
rangeWinStart = rangeWin and not rangeWin[1]

var float rangeHigh    = na
var float rangeLow     = na
var int   rangeBars    = 0
var bool  tradedToday  = false
var bool  blockedToday = false   // a close below the range low came first
var bool  inPos        = false
var float entryPx      = na
var int   entryBar     = na
var float dayPts       = 0.0
var float totPts       = 0.0
var int   totTrades    = 0
var int   totStops     = 0

tsIso() =>
    str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

f_usd(float v) => (v >= 0 ? "+$" : "-$") + str.tostring(math.abs(v), "#,##0")

string alertAction = ""
string alertReason = ""
float  exitPx      = na
float  tradePts    = na

if barstate.isconfirmed
    if rangeWinStart
        rangeHigh    := high
        rangeLow     := low
        rangeBars    := 1
        tradedToday  := false
        blockedToday := false
        dayPts       := 0.0
    else if rangeWin
        rangeHigh := math.max(rangeHigh, high)
        rangeLow  := math.min(rangeLow, low)
        rangeBars += 1

    rangeComplete = rangeBars >= 15

    // ---- exits first (only bars strictly after the entry bar) ----
    if inPos and bar_index > entryBar
        if USE_STOP and low <= rangeLow
            exitPx      := rangeLow
            alertReason := "stop_range_low"
            totStops    += 1
        else if lastBar
            exitPx      := close
            alertReason := "session_close"
        else if not inSession and not rangeWin
            exitPx      := close
            alertReason := "late_flatten_EXCLUDE_FROM_SCORING"
        if not na(exitPx)
            tradePts    := exitPx - entryPx
            dayPts      += tradePts
            totPts      += tradePts
            totTrades   += 1
            inPos       := false
            alertAction := "exit"

    // ---- entry ----
    if canTrade and not inPos and not tradedToday and not blockedToday and inSession and rangeComplete and not skipDay and not lastBar and na(exitPx)
        if close < rangeLow
            blockedToday := true
        else if close > rangeHigh
            inPos       := true
            tradedToday := true
            entryPx     := close
            entryBar    := bar_index
            alertAction := "buy"
            alertReason := "orb_break_up"

f_msg(string action, string reason) =>
    string m = '{"variant":"' + VARIANT + '","action":"' + action + '"'
    if action == "buy"
        m += ',"price":' + str.tostring(close) + ',"qty":' + str.tostring(QTY) + ',"range_low":' + str.tostring(rangeLow) + ',"range_high":' + str.tostring(rangeHigh)
    else
        m += ',"entry":' + str.tostring(entryPx) + ',"exit":' + str.tostring(exitPx) + ',"pnl_pts":' + str.tostring(tradePts)
    m += ',"reason":"' + reason + '","time":"' + tsIso() + '"' + (TEST_MODE ? ',"test":true' : '') + '}'
    m

if alertAction != "" and canTrade
    alert(f_msg(alertAction, alertReason), alert.freq_once_per_bar_close)
    log.info(str.format_time(time_close, "yyyy-MM-dd HH:mm", "America/New_York") + " " + VARIANT + " " + alertAction + " " + alertReason + (alertAction == "exit" ? " pnl_pts=" + str.tostring(tradePts) : " @" + str.tostring(close)))

plot(rangeBars >= 15 and (inSession or lastBar) ? rangeHigh : na, "Opening range high", color=color.new(color.green, 0), style=plot.style_stepline)
plot(rangeBars >= 15 and (inSession or lastBar) ? rangeLow : na, "Opening range low", color=color.new(color.orange, 0), style=plot.style_stepline)
plotshape(alertAction == "buy", "Entry", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(alertAction == "exit", "Exit", style=shape.xcross, location=location.abovebar, color=color.gray, size=size.tiny)

if alertAction == "exit" and canTrade
    label.new(bar_index, high, VARIANT + " " + alertReason + "\n" + f_usd(tradePts * syminfo.pointvalue * QTY) + " (no costs)", style=label.style_label_down, color=tradePts >= 0 ? color.teal : color.gray, textcolor=color.white, size=size.small)

var table info = table.new(position.bottom_right, 2, 5, bgcolor=color.new(color.black, 20), border_width=1)
if barstate.islast
    pv = syminfo.pointvalue * QTY
    table.cell(info, 0, 0, "PAPER TEST ONLY  (Variant " + VARIANT + ")", text_color=color.yellow)
    table.cell(info, 1, 0, canTrade ? "chart OK" : "BLOCKED: use MNQ 1-min", text_color=canTrade ? color.lime : color.red)
    table.cell(info, 0, 1, "Position", text_color=color.white)
    table.cell(info, 1, 1, inPos ? "LONG @" + str.tostring(entryPx) : "flat", text_color=color.white)
    table.cell(info, 0, 2, "Chart history (paper)", text_color=color.white)
    table.cell(info, 1, 2, str.tostring(totTrades) + " trades, " + f_usd(totPts * pv) + " (no costs)", text_color=color.white)
    table.cell(info, 0, 3, "Stops hit", text_color=color.white)
    table.cell(info, 1, 3, USE_STOP ? str.tostring(totStops) : "n/a (no stop)", text_color=color.white)
    table.cell(info, 0, 4, "Mode", text_color=color.white)
    table.cell(info, 1, 4, TEST_MODE ? "test:true on every alert" : "LIVE", text_color=TEST_MODE ? color.lime : color.red)
