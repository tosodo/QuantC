//@version=5
indicator("QuantC ORB Long MES v2 (validated) - Ghost (Accessible)", overlay=true, max_lines_count=50, max_labels_count=500)

// ============================================================================
// ACCESSIBLE VERSION of orb_long_ghost_DRAFT_mes_v2.pine.
//
// TRADING LOGIC IS UNCHANGED (except the 2026-09-26 stale-data entry guard,
// described below) - every line under "STRATEGY CALCULATIONS" and
// "ENTRY / EXIT" below, and the two alert() calls, are copied verbatim from
// the original draft. Nothing about when a trade fires, what stop distance
// is used, or what JSON is sent to Ghost has been touched. Everything below
// "ACCESSIBILITY SETTINGS" and "VISUALS" is new: it only reads values the
// original script already computes and draws them more clearly.
//
// See orb_long_ghost_DRAFT_mes_v2.pine for the full research rationale
// (stop distance, time-exit, slippage findings) - not repeated here.
//
// LIVE since 2026-09-09: testMode was switched off and the TradingView alert
// recreated so real orders reach Ghost/Tradovate. This file was renamed and
// re-synced 2026-09-10 to match that deployed state (was previously titled
// "DRAFT, NOT LIVE" with testMode defaulting to true here even though the
// live copy on TradingView had already been changed - the two had drifted
// apart). Named "(validated) - Ghost" to match the naming pattern already
// used for the other proven strategies. The sibling
// orb_long_ghost_DRAFT_mes_v2.pine (non-accessible) is NOT live - it is
// intentionally still a dormant draft, sitting unused on the "QuantC -
// Drafts & Testing" chart, and correctly keeps its "DRAFT, NOT LIVE" name
// and testMode=true default.
//
// STALE-DATA GUARD added 2026-09-26 (council review, Phase 1). The week of
// 2026-09-21 every alert fired ~10 min after its bar closed because the
// CME real-time feed was not reaching TradingView's alert servers, so
// entries went to Ghost at prices the backtest never tested. On REALTIME
// bars only, a breakout bar that is processed more than maxAlertLagSec after
// it closed does NOT send a buy - the script stands down for the day instead
// (no later, untested re-entry). Exit alerts are never blocked, the JSON
// sent to Ghost is byte-for-byte unchanged, and historical bars are not
// affected, so the chart and backtest behaviour are identical to before.
// ============================================================================

// ---------------------------------------------------------------------------
// 1. INPUTS (original, unchanged)
// ---------------------------------------------------------------------------
qty            = input.int(1, "Contracts per signal", minval=1, maxval=1, group="Strategy", tooltip="Fixed at 1 MES micro contract - dynamic ATR-based sizing was tested and rejected (see the closed hypothesis note).")
testMode       = input.bool(false, "Test mode (Ghost dry-run, no real orders)", group="Strategy", tooltip="Adds \"test\":true to every alert. Turn OFF only when you are ready for signals to place real orders - that switch is yours to make deliberately.")
maxRiskDollars = input.float(625, "Max $ risk per trade (stop is derived from this)", minval=1, group="Strategy", tooltip="Stop distance = this / (qty x point value) - see orb_long_ghost_DRAFT_mes_v2.pine's header comment for the full sizing rationale and 5-year backtest result.")
timeExitMin    = input.int(90, "Underwater time-exit, minutes after entry", minval=1, group="Strategy")

enableFundedPhaseCap  = input.bool(false, "Funded phase: cap profit per trade (Lucid 40% consistency rule)", group="Strategy", tooltip="OFF during evaluation - see orb_long_ghost_DRAFT_mes_v2.pine's header comment. Turn ON once funded.")
maxDailyProfitDollars = input.float(300, "Max profit per trade before force-exit (funded phase only)", minval=1, group="Strategy", tooltip="Only used when the toggle above is ON. Default $300 = 40% of the confirmed $750/cycle funded payout target.")

enableStaleGuard = input.bool(true, "Block entries on stale (delayed) data", group="Data Safety", tooltip="On realtime bars, skip the day's entry if the breakout bar is processed more than the lag limit after it closed. Exits are never blocked.")
maxAlertLagSec   = input.int(90, "Max data lag for an entry (seconds)", minval=10, group="Data Safety", tooltip="Live CME data is processed within a few seconds of bar close; delayed data is ~600s.")

stopPoints = maxRiskDollars / (qty * syminfo.pointvalue)

// ---------------------------------------------------------------------------
// 2. ACCESSIBILITY SETTINGS (new - presentation only, no effect on alerts)
// ---------------------------------------------------------------------------
enableAccessibleMode = input.bool(true, "Enable accessible mode", group="Accessibility Settings", tooltip="Master switch for everything below. Turn off to fall back to the plain original chart.")
showDashboard         = input.bool(true, "Show status dashboard", group="Accessibility Settings")
dashPosition          = input.string("Top Right", "Dashboard position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Accessibility Settings")
showBuyEntryLabels    = input.bool(true, "Show BUY / ENTRY labels", group="Accessibility Settings")
showStopLabels        = input.bool(true, "Show STOP labels", group="Accessibility Settings")
showExitLabels        = input.bool(true, "Show EXIT labels", group="Accessibility Settings")
showHistoricalSignals = input.bool(true, "Show historical signals", group="Accessibility Settings", tooltip="If off, only the most recent trade's labels are kept on the chart.")
maxHistoricalSignals  = input.int(20, "Max historical signals to keep", minval=1, maxval=200, group="Accessibility Settings")
signalLabelSize       = input.string("Large", "Signal label size", options=["Normal", "Large"], group="Accessibility Settings")
lineWidthInput        = input.int(3, "Line width (structure / stop)", minval=1, maxval=6, group="Accessibility Settings")
highContrastMode      = input.bool(true, "High contrast mode", group="Accessibility Settings", tooltip="Increases line width and uses fully opaque colours when on.")

entryColor     = input.color(color.white,   "Entry / BUY colour",  group="Accessibility Colours")
stopColor      = input.color(#FF6B6B,       "Stop colour",         group="Accessibility Colours")
exitColor      = input.color(#B8C0CC,       "Exit colour",         group="Accessibility Colours")
warningColor   = input.color(#FFD166,       "Warning colour",      group="Accessibility Colours")
structureColor = input.color(#A78BFA,       "Structure (OR) colour", group="Accessibility Colours")

labelSize    = signalLabelSize == "Large" ? size.large : size.normal
lineWidthFx  = highContrastMode ? lineWidthInput + 1 : lineWidthInput

// ---------------------------------------------------------------------------
// 3. STRATEGY CALCULATIONS (original, unchanged)
// ---------------------------------------------------------------------------
validSymbol    = syminfo.ticker == "MES1!" or syminfo.root == "MES"
validTimeframe = timeframe.period == "1"

if barstate.islast and not validSymbol
    label.new(bar_index, high, "BLOCKED: this draft is validated for MES only.\nCurrent chart: " + syminfo.ticker + "\nMNQ was tested and rejected - no signal will fire here.", style=label.style_label_down, color=warningColor, textcolor=color.black, size=labelSize)

var float rangeHigh       = na
var float rangeLow        = na
var int   rangeBarCount   = 0
var bool  tradedToday     = false
var bool  inPosition      = false
var float entryPrice      = na
var int   entryTime       = na

rangeWin        = not na(time(timeframe.period, "0930-0945", "America/New_York"))
fullSession     = not na(time(timeframe.period, "0945-1600", "America/New_York"))
sessionLastBar  = not na(time(timeframe.period, "1559-1600", "America/New_York"))
rangeWinStart   = rangeWin and not rangeWin[1]

if rangeWinStart
    rangeHigh       := high
    rangeLow        := low
    rangeBarCount   := 1
    tradedToday     := false
else if rangeWin
    rangeHigh       := math.max(rangeHigh, high)
    rangeLow        := math.min(rangeLow, low)
    rangeBarCount   += 1

rangeComplete = rangeBarCount >= 15
longSignal    = fullSession and not tradedToday and rangeComplete and close > rangeHigh and validSymbol and validTimeframe

// Stale-data guard (see header). timenow - time_close is ~0-5s on a live
// feed and ~600s on a 10-min delayed feed. Historical bars are never gated.
barLagSec     = barstate.isrealtime ? (timenow - time_close) / 1000.0 : 0.0
dataStale     = enableStaleGuard and barstate.isrealtime and barLagSec > maxAlertLagSec
takeEntry     = longSignal and not dataStale
staleBlocked  = longSignal and dataStale

var bool  staleSkipToday = false
var float lastLagSec     = na
if rangeWinStart
    staleSkipToday := false
if barstate.isrealtime and barstate.isconfirmed
    lastLagSec := barLagSec

minutesSinceEntry = inPosition ? (time - entryTime) / 60000 : na
pastTimeExitCutoff = inPosition and fullSession and minutesSinceEntry >= timeExitMin
timeExitTriggered   = pastTimeExitCutoff and close <= entryPrice   // re-checked every bar past the cutoff (M1 fix)
unrealizedProfitDollars = inPosition ? (close - entryPrice) * qty * syminfo.pointvalue : na
profitCapTriggered  = enableFundedPhaseCap and inPosition and unrealizedProfitDollars >= maxDailyProfitDollars
closeExitSignal     = sessionLastBar and inPosition
catchAllFlatten     = inPosition and not fullSession   // half-day / early-close backstop
exitSignal           = timeExitTriggered or profitCapTriggered or closeExitSignal or catchAllFlatten

tsIso() =>
    str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

// ---------------------------------------------------------------------------
// 4. ENTRY / EXIT + ALERTS (JSON unchanged - this is what Ghost receives;
//    only the entry is gated by the stale-data guard)
// ---------------------------------------------------------------------------
var string lastExitReason = na

if staleBlocked
    tradedToday    := true    // stand down for the day - no later, untested re-entry
    staleSkipToday := true

if takeEntry
    tradedToday     := true
    inPosition      := true
    entryPrice      := close
    entryTime       := time
    stopPrice = close - stopPoints
    msg = '{"action":"buy","price":' + str.tostring(close) + ',"qty":' + str.tostring(qty) +
          ',"sl":' + str.tostring(stopPrice) +
          ',"time":"' + tsIso() + '"' + (testMode ? ',"test":true' : '') + '}'
    alert(msg, alert.freq_once_per_bar_close)

if exitSignal
    inPosition := false
    reason = profitCapTriggered ? "funded_profit_cap" : timeExitTriggered ? "time_exit_90min" : catchAllFlatten ? "catch_all_flatten" : "session_close"
    lastExitReason := reason
    msg = '{"action":"exit","reason":"' + reason + '","time":"' + tsIso() + '"' + (testMode ? ',"test":true' : '') + '}'
    alert(msg, alert.freq_once_per_bar_close)

// ---------------------------------------------------------------------------
// 5. VISUAL HELPERS (new)
// ---------------------------------------------------------------------------
var label[] signalLabels = array.new_label()

trackLabel(lbl) =>
    array.push(signalLabels, lbl)
    keep = showHistoricalSignals ? maxHistoricalSignals * 3 : 3
    if array.size(signalLabels) > keep
        label.delete(array.shift(signalLabels))

sessionStateText() =>
    string txt = na
    if rangeWin
        txt := "RANGE BUILDING"
    else if inPosition
        txt := "IN TRADE"
    else if fullSession
        txt := "IN SESSION"
    else
        txt := "SESSION CLOSED"
    txt

signalStateText() =>
    string txt = na
    if inPosition
        txt := "LONG (OPEN)"
    else if staleSkipToday
        txt := "SKIPPED - STALE DATA"
    else if tradedToday
        txt := "DONE FOR DAY"
    else if rangeComplete and fullSession
        txt := "NO TRADE - WAITING FOR BREAKOUT"
    else if rangeWin
        txt := "NO TRADE - BUILDING RANGE"
    else
        txt := "NO TRADE - OUTSIDE SESSION"
    txt

exitReasonText(reason) =>
    reason == "time_exit_90min" ? "TIME EXIT (90min underwater)" : reason == "session_close" ? "SESSION CLOSE" : reason == "funded_profit_cap" ? "FUNDED PROFIT CAP" : reason == "catch_all_flatten" ? "CATCH-ALL FLATTEN (half-day?)" : reason

// ---------------------------------------------------------------------------
// 6. STRUCTURE VISUALISATION (opening range lines - shape-differentiated, not just colour)
// ---------------------------------------------------------------------------
orShown = rangeComplete and fullSession
plot(orShown ? rangeHigh : na, title="Opening range high", color=enableAccessibleMode ? structureColor : color.new(color.green, 0), style=plot.style_stepline, linewidth=enableAccessibleMode ? lineWidthFx : 1)
plot(orShown ? rangeLow : na, title="Opening range low", color=enableAccessibleMode ? structureColor : color.new(color.red, 0), style=enableAccessibleMode ? plot.style_stepline_diamond : plot.style_stepline, linewidth=enableAccessibleMode ? lineWidthFx : 1)
plot(inPosition ? entryPrice - stopPoints : na, title="Stop-loss level", color=enableAccessibleMode ? stopColor : color.new(color.orange, 0), style=plot.style_circles, linewidth=enableAccessibleMode ? lineWidthFx : 1)

// ---------------------------------------------------------------------------
// 7. SIGNAL / ENTRY / STOP / EXIT LABELS (new - bounded, event-anchored)
// ---------------------------------------------------------------------------
if enableAccessibleMode and takeEntry and showBuyEntryLabels
    buyLbl = label.new(bar_index, low, "▲ BUY\nENTRY " + str.tostring(close, format.mintick), style=label.style_label_up, color=entryColor, textcolor=color.black, size=labelSize)
    trackLabel(buyLbl)

if enableAccessibleMode and takeEntry and showStopLabels
    stopLbl = label.new(bar_index, close - stopPoints, "✕ STOP\n" + str.tostring(close - stopPoints, format.mintick), style=label.style_label_down, color=stopColor, textcolor=color.white, size=labelSize)
    trackLabel(stopLbl)

if enableAccessibleMode and staleBlocked
    skipLbl = label.new(bar_index, low, "⚠ ENTRY SKIPPED\nSTALE DATA (" + str.tostring(barLagSec, "#") + "s late)", style=label.style_label_up, color=warningColor, textcolor=color.black, size=labelSize)
    trackLabel(skipLbl)

if enableAccessibleMode and exitSignal and showExitLabels
    exitLbl = label.new(bar_index, high, "EXIT\n" + exitReasonText(lastExitReason), style=label.style_label_down, color=exitColor, textcolor=color.black, size=labelSize)
    trackLabel(exitLbl)

// Non-accessible fallback markers (kept so turning accessible mode off doesn't lose signal visibility entirely)
plotshape(not enableAccessibleMode and takeEntry, title="Long signal (plain)", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(not enableAccessibleMode and exitSignal, title="Exit signal (plain)", style=shape.xcross, location=location.abovebar, color=color.gray, size=size.tiny)

// ---------------------------------------------------------------------------
// 8. WRONG-TIMEFRAME WARNING (original condition, restyled)
// ---------------------------------------------------------------------------
if barstate.islast and not validTimeframe
    label.new(bar_index, high, "⛔ BLOCKED\nWRONG TIMEFRAME - validated on the 1-minute chart only.\nCurrently running on: " + timeframe.period + "\nNo signal will fire here.", style=label.style_label_down, color=warningColor, textcolor=color.black, size=labelSize)

// ---------------------------------------------------------------------------
// 9. DASHBOARD (new - always reflects current state, not historical)
// ---------------------------------------------------------------------------
posMap(p) =>
    p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : position.bottom_left

var table dash = table.new(posMap(dashPosition), 2, 10, border_width=1)

addRow(rowIdx, lbl, val, valColor) =>
    table.cell(dash, 0, rowIdx, lbl, text_color=color.white, text_size=size.normal, bgcolor=#1B2230)
    table.cell(dash, 1, rowIdx, val, text_color=valColor, text_size=size.normal, bgcolor=#1B2230)

if enableAccessibleMode and showDashboard and barstate.islast
    wrongSymbol    = not validSymbol
    wrongTimeframe = not validTimeframe
    row = 0
    addRow(row, "SESSION", sessionStateText(), color.white)
    row += 1
    addRow(row, "SIGNAL", signalStateText(), inPosition ? entryColor : color.white)
    row += 1
    addRow(row, "OR HIGH", rangeComplete ? str.tostring(rangeHigh, format.mintick) : "—", color.white)
    row += 1
    addRow(row, "OR LOW", rangeComplete ? str.tostring(rangeLow, format.mintick) : "—", color.white)
    row += 1
    addRow(row, "ENTRY", inPosition ? str.tostring(entryPrice, format.mintick) : "—", entryColor)
    row += 1
    addRow(row, "STOP", inPosition ? str.tostring(entryPrice - stopPoints, format.mintick) : "—", stopColor)
    row += 1
    addRow(row, "TAKE PROFIT", "N/A - time / session exit", color.gray)
    row += 1
    addRow(row, "TIME EXIT", str.tostring(timeExitMin) + " min underwater", color.white)
    row += 1
    lagStale = not na(lastLagSec) and lastLagSec > maxAlertLagSec
    addRow(row, "DATA LAG", na(lastLagSec) ? "— (no live bar yet)" : str.tostring(lastLagSec, "#") + "s" + (lagStale ? " - STALE, entries blocked" : " - OK"), lagStale ? warningColor : color.white)
    row += 1
    if wrongSymbol or wrongTimeframe
        addRow(row, "BLOCKED", wrongSymbol ? "WRONG SYMBOL" : "WRONG TIMEFRAME", warningColor)
